import { Theme } from "theme.slint";

export component Icon inherits Image {
    in property <image> glyph;
    in property <color> tint: Theme.text;
    in property <length> size: 18px;
    source: glyph;
    colorize: tint;
    width: size;
    height: size;
    image-fit: contain;
}

export component IconBtn inherits Rectangle {
    in property <image> glyph;
    in property <string> tip;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> size: 32px;
    in property <length> icon-size: 18px;
    in property <color> tint: Theme.text;
    callback clicked();
    width: size;
    height: size;
    border-radius: 4px;
    background: !enabled ? transparent : active ? Theme.subtle-hover : ta.pressed ? Theme.subtle-press : ta.has-hover ? Theme.subtle-hover : transparent;
    animate background { duration: Theme.t-fast; }
    Icon { glyph: root.glyph; size: root.icon-size; tint: !root.enabled ? Theme.text-disabled : root.active ? Theme.accent-text : root.tint; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    property <bool> show-tip: false;
    Timer { interval: 600ms; running: ta.has-hover && root.tip != "" && !root.show-tip; triggered() => { root.show-tip = true; } }
    property <bool> hov: ta.has-hover;
    changed hov => { if (!root.hov) { root.show-tip = false; } }
    if root.show-tip && ta.has-hover : Rectangle {
        y: root.height + 4px; x: (root.width - self.width) / 2;
        width: tip-text.preferred-width + 16px; height: 26px; border-radius: 4px;
        background: Theme.flyout; border-width: 1px; border-color: Theme.stroke-strong;
        drop-shadow-blur: 8px; drop-shadow-color: #00000030;
        tip-text := Text { text: root.tip; color: Theme.text; font-size: Theme.fs-small; horizontal-alignment: center; vertical-alignment: center; }
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> glyph;
    in property <bool> accent: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    min-width: 32px;
    border-radius: 4px;
    border-width: accent ? 0px : 1px;
    border-color: Theme.control-stroke;
    background: !enabled ? Theme.subtle-hover
        : accent ? (ta.pressed ? Theme.accent-press : ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.pressed ? Theme.control-press : ta.has-hover ? Theme.control-hover : Theme.control);
    animate background { duration: Theme.t-fast; }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: center;
        if root.glyph.width > 0 : Icon { glyph: root.glyph; size: 16px; tint: root.accent ? Theme.on-accent : root.danger ? Theme.danger : Theme.text; y: (parent.height - self.height) / 2; }
        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-disabled : root.accent ? Theme.on-accent : root.danger ? Theme.danger : Theme.text;
            font-size: Theme.fs;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component FSwitch inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);
    width: 40px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Theme.accent : transparent;
    border-width: 1px;
    border-color: checked ? Theme.accent : Theme.text-2;
    animate background { duration: Theme.t-fast; }
    Rectangle {
        width: checked ? 14px : 12px;
        height: self.width;
        border-radius: self.width / 2;
        y: (parent.height - self.height) / 2;
        x: checked ? parent.width - self.width - 4px : 4px;
        background: checked ? Theme.on-accent : Theme.text-2;
        animate x { duration: Theme.t-fast; easing: ease-out; }
        animate width { duration: Theme.t-fast; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}

export component FSlider inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    // fires on every move; `released` once when the user lets go
    callback changed(float);
    callback released(float);
    height: 24px;
    min-width: 80px;
    property <float> span: max(0.0001, maximum - minimum);
    property <float> frac: clamp((value - minimum) / span, 0, 1);
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px; border-radius: 2px; background: Theme.text-3;
        // bipolar sliders (minimum below zero) fill from the zero mark, like Windows settings
        property <float> zero: root.minimum < 0 ? clamp((0 - root.minimum) / root.span, 0, 1) : 0;
        Rectangle { x: min(root.frac, parent.zero) * parent.width; width: abs(root.frac - parent.zero) * parent.width; height: parent.height; border-radius: 2px; background: Theme.accent; }
    }
    Rectangle {
        width: 20px; height: 20px; border-radius: 10px;
        x: root.frac * (parent.width - self.width);
        y: (parent.height - self.height) / 2;
        background: Theme.control-solid; border-width: 1px; border-color: Theme.control-stroke;
        drop-shadow-blur: 3px; drop-shadow-color: #00000040; drop-shadow-offset-y: 1px;
        Rectangle { width: ta.pressed ? 10px : ta.has-hover ? 14px : 12px; height: self.width; border-radius: self.width / 2; background: Theme.accent; animate width { duration: Theme.t-fast; } }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        property <float> last;
        function set(x: length) {
            let raw = root.minimum + clamp((x - 10px) / max(1px, root.width - 20px), 0, 1) * root.span;
            let snapped = root.step > 0 ? round(raw / root.step) * root.step : raw;
            last = clamp(snapped, root.minimum, root.maximum);
            root.changed(last);
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { self.set(self.mouse-x); }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { root.released(self.last); }
        }
        moved => { if (self.pressed) { self.set(self.mouse-x); } }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();
    height: 30px;
    border-radius: 15px;
    border-width: 1px;
    border-color: active ? Theme.accent : Theme.control-stroke;
    background: active ? Theme.accent : ta.pressed ? Theme.control-press : ta.has-hover ? Theme.control-hover : Theme.control;
    animate background { duration: Theme.t-fast; }
    HorizontalLayout { padding-left: 12px; padding-right: 12px; alignment: center;
        Text { text: root.text; color: root.active ? Theme.on-accent : Theme.text; font-size: Theme.fs; vertical-alignment: center; } }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> index;
    callback picked(int);
    height: 32px;
    border-radius: 4px;
    background: Theme.subtle-hover;
    HorizontalLayout {
        padding: 2px; spacing: 2px;
        for item[i] in root.items : Rectangle {
            border-radius: 3px;
            background: root.index == i ? Theme.control-solid : transparent;
            border-width: root.index == i ? 1px : 0px;
            border-color: Theme.stroke;
            Text { text: item; color: Theme.text; font-size: Theme.fs; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
        }
    }
}

export component Skeleton inherits Rectangle {
    background: Theme.subtle-hover;
}

// A pop-up list used for sort / folder / format pickers (opens below the button).
export component Dropdown inherits Rectangle {
    in property <[string]> items;
    in property <int> index;
    in property <string> label;
    callback picked(int);
    height: 32px;
    min-width: 120px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.control-stroke;
    background: ta.pressed ? Theme.control-press : ta.has-hover ? Theme.control-hover : Theme.control;
    HorizontalLayout {
        padding-left: 10px; padding-right: 8px; spacing: 6px;
        Text { text: root.items.length > root.index && root.index >= 0 ? root.items[root.index] : root.label; color: Theme.text; font-size: Theme.fs; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Icon { glyph: @image-url("icons/chevron-down.svg"); size: 14px; tint: Theme.text-2; y: (parent.height - self.height) / 2; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { pop.show(); } }
    pop := PopupWindow {
        x: 0px; y: root.height + 2px;
        width: max(root.width, 180px);
        Rectangle {
            background: Theme.flyout; border-radius: 8px; border-width: 1px; border-color: Theme.stroke-strong; drop-shadow-blur: 24px; drop-shadow-color: #00000040; drop-shadow-offset-y: 4px;
            Flickable {
                content-height: col.preferred-height;
                max-height: 320px;
                col := VerticalLayout {
                    padding: 4px; spacing: 1px;
                    for item[i] in root.items : Rectangle {
                        height: 32px; border-radius: 4px;
                        background: i == root.index ? Theme.subtle-hover : ia.has-hover ? Theme.subtle-hover : transparent;
                        HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 8px;
                            Rectangle { width: 3px; height: 16px; y: (parent.height - self.height) / 2; border-radius: 1.5px; background: i == root.index ? Theme.accent : transparent; }
                            Text { text: item; color: Theme.text; font-size: Theme.fs; vertical-alignment: center; overflow: elide; } }
                        ia := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
                    }
                }
            }
        }
    }
}


export component FTextBox inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    callback accepted(string);
    public function focus-and-select() { ti.focus(); ti.select-all(); }
    height: 32px;
    border-radius: 4px;
    background: ti.has-focus ? (Theme.dark ? #1f1f1f : #ffffff) : Theme.control;
    border-width: 1px;
    border-color: Theme.control-stroke;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.text-3; opacity: ti.has-focus ? 0 : 0.5; }
    Rectangle { y: parent.height - 2px; height: 2px; background: ti.has-focus ? Theme.accent : transparent; border-radius: 1px; }
    ti := TextInput {
        x: 10px; width: parent.width - 20px; height: parent.height;
        vertical-alignment: center;
        text <=> root.text;
        color: Theme.text;
        font-size: Theme.fs;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
    if root.text == "" && root.placeholder != "" : Text { x: 10px; text: root.placeholder; color: Theme.text-3; font-size: Theme.fs; vertical-alignment: center; height: parent.height; }
}

export component Stepper inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 99999;
    callback changed(int);
    height: 32px;
    width: 110px;
    border-radius: 4px; border-width: 1px; border-color: Theme.control-stroke; background: Theme.control;
    HorizontalLayout {
        IconBtn { glyph: @image-url("icons/minus.svg"); size: 30px; icon-size: 14px; clicked => { root.value = max(root.minimum, root.value - 1); root.changed(root.value); } }
        Text { text: root.value; color: Theme.text; font-size: Theme.fs; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
        IconBtn { glyph: @image-url("icons/plus.svg"); size: 30px; icon-size: 14px; clicked => { root.value = min(root.maximum, root.value + 1); root.changed(root.value); } }
    }
}
