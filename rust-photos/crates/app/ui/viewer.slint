import { Theme, Tr } from "theme.slint";
import { App } from "state.slint";
import { Icon, IconBtn, Btn, Skeleton } from "widgets.slint";

export component ViewerView inherits Rectangle {
    property <float> zoom: 1.0;
    property <length> pan-x: 0px;
    property <length> pan-y: 0px;
    property <length> vw: area.width;
    property <length> vh: area.height;
    // "fit" never enlarges a small picture beyond its real size
    property <float> fit: min(1.0, min(vw / max(1px, App.view-w * 1px), vh / max(1px, App.view-h * 1px)));
    property <length> iw: App.view-w * 1px * fit * zoom;
    property <length> ih: App.view-h * 1px * fit * zoom;
    function clamp-pan() {
        let mx = max(0px, (iw - vw) / 2);
        let my = max(0px, (ih - vh) / 2);
        pan-x = clamp(pan-x, -mx, mx);
        pan-y = clamp(pan-y, -my, my);
    }
    function zoom-to(z: float, cx: length, cy: length) {
        let nz = clamp(z, 0.1, 24);
        let k = nz / zoom;
        // keep the point under the cursor where it is
        pan-x = (cx - vw / 2) - ((cx - vw / 2) - pan-x) * k;
        pan-y = (cy - vh / 2) - ((cy - vh / 2) - pan-y) * k;
        zoom = nz;
        clamp-pan();
    }
    public function fit-window() { zoom = 1.0; pan-x = 0px; pan-y = 0px; }
    public function actual-size() { zoom = fit > 0 ? 1.0 / fit : 1.0; pan-x = 0px; pan-y = 0px; }
    public function zoom-step(f: float) { zoom-to(zoom * f, vw / 2, vh / 2); }
    changed zoom => { App.act("zoom-text", round(zoom * fit * 100)); }
    in property <int> rev: App.view-rev;
    changed rev => { fit-window(); }

    background: Theme.viewer-bg;

    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 1;
            // top bar
            if !App.fullscreen : Rectangle {
                height: 48px; background: Theme.layer;
                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 4px;
                    IconBtn { y: 8px; glyph: @image-url("icons/chevron-left.svg"); tip: Tr.t("back"); clicked => { App.act("back", 0); } }
                    Text { text: App.view-name; color: Theme.text; font-size: Theme.fs; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: App.view-index-text; color: Theme.text-3; font-size: Theme.fs-small; vertical-alignment: center; }
                    IconBtn { y: 8px; glyph: @image-url("icons/heart.svg"); active: App.view-fav; tip: App.view-fav ? Tr.t("fav.remove") : Tr.t("fav.add"); tint: App.view-fav ? #ff5b7a : Theme.text; clicked => { App.act("view-fav", 0); } }
                    IconBtn { y: 8px; glyph: @image-url("icons/pencil.svg"); tip: Tr.t("act.edit"); clicked => { App.act("view-edit", 0); } }
                    IconBtn { y: 8px; glyph: @image-url("icons/rotate-ccw.svg"); tip: Tr.t("act.rotateLeft"); clicked => { App.act("view-rotate", 270); } }
                    IconBtn { y: 8px; glyph: @image-url("icons/rotate-cw.svg"); tip: Tr.t("act.rotateRight"); clicked => { App.act("view-rotate", 90); } }
                    IconBtn { y: 8px; glyph: @image-url("icons/play.svg"); active: App.slideshow; tip: Tr.t("act.slideshow"); clicked => { App.act("slideshow", 0); } }
                    IconBtn { y: 8px; glyph: @image-url("icons/info.svg"); active: App.info-open; tip: Tr.t("act.info"); clicked => { App.info-open = !App.info-open; App.act("info", 0); } }
                    IconBtn { y: 8px; glyph: @image-url("icons/ellipsis.svg"); tip: Tr.t("act.menu");
                        clicked => { more.show(); }
                        more := PopupWindow { x: parent.width - 220px; y: 36px; width: 220px;
                            Rectangle { background: Theme.card; border-radius: 6px; border-width: 1px; border-color: Theme.stroke-strong; drop-shadow-blur: 16px; drop-shadow-color: #00000040;
                                VerticalLayout { padding: 4px; spacing: 1px;
                                    for it[i] in [
                                        { k: "view-copy", t: Tr.t("act.copyImage") }, { k: "view-copy-path", t: Tr.t("act.copyPath") },
                                        { k: "view-reveal", t: Tr.t("act.reveal") }, { k: "view-print", t: Tr.t("act.print") },
                                        { k: "view-wallpaper", t: Tr.t("act.wallpaper") }, { k: "view-rename", t: Tr.t("rename") },
                                        { k: "view-copy-to", t: Tr.t("act.copyTo") }, { k: "view-move-to", t: Tr.t("act.moveTo") },
                                        { k: "view-album", t: Tr.t("alb.addTo") }, { k: "view-delete", t: Tr.t("delete") } ] : Rectangle {
                                        height: 32px; border-radius: 4px; background: mi.has-hover ? Theme.subtle-hover : transparent;
                                        Text { x: 12px; text: it.t; color: it.k == "view-delete" ? Theme.danger : Theme.text; font-size: Theme.fs; vertical-alignment: center; }
                                        mi := TouchArea { mouse-cursor: pointer; clicked => { App.act(it.k, 0); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // picture
            area := Rectangle {
                vertical-stretch: 1;
                clip: true;
                if !App.view-failed && App.view-w > 0 : Image {
                    source: App.view-image;
                    width: root.iw; height: root.ih;
                    x: (parent.width - self.width) / 2 + root.pan-x;
                    y: (parent.height - self.height) / 2 + root.pan-y;
                    image-rendering: root.zoom * root.fit > 2 ? pixelated : smooth;
                }
                if App.view-loading && App.view-w == 0 : Text { text: Tr.t("loading"); color: Theme.text-2; font-size: Theme.fs; horizontal-alignment: center; vertical-alignment: center; }
                if App.view-failed : VerticalLayout { alignment: center; spacing: 8px;
                    Icon { glyph: @image-url("icons/triangle-alert.svg"); size: 40px; tint: Theme.text-3; x: (parent.width - 40px) / 2; }
                    Text { text: Tr.t("view.loadFail"); color: Theme.text-2; font-size: Theme.fs; horizontal-alignment: center; } }
                ta := TouchArea {
                    mouse-cursor: root.zoom > 1.001 ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
                    scroll-event(e) => {
                        root.zoom-to(root.zoom * pow(1.0016, e.delta-y / 1px), self.mouse-x, self.mouse-y);
                        accept
                    }
                    property <length> sx; property <length> sy; property <length> px0; property <length> py0;
                    pointer-event(e) => {
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { self.sx = self.mouse-x; self.sy = self.mouse-y; self.px0 = root.pan-x; self.py0 = root.pan-y; }
                    }
                    moved => {
                        if (self.pressed) { root.pan-x = self.px0 + self.mouse-x - self.sx; root.pan-y = self.py0 + self.mouse-y - self.sy; root.clamp-pan(); }
                    }
                    double-clicked => { if (root.zoom > 1.01) { root.fit-window(); } else { root.zoom-to(2.0 / root.fit > 8 ? 8 : 2.0 / max(0.01, root.fit) * root.fit * 1.0 + 1.0, self.mouse-x, self.mouse-y); } }
                }
                // side arrows
                if App.has-prev : Rectangle { x: 10px; y: (parent.height - 44px) / 2; width: 36px; height: 44px; border-radius: 6px;
                    background: pa.has-hover ? #00000099 : #00000040; opacity: (ta.has-hover || pa.has-hover) ? 1 : 0; animate opacity { duration: Theme.t-fast; }
                    Icon { glyph: @image-url("icons/chevron-left.svg"); size: 22px; tint: #ffffff; x: 7px; y: 11px; }
                    pa := TouchArea { mouse-cursor: pointer; clicked => { App.act("prev", 0); } } }
                if App.has-next : Rectangle { x: parent.width - 46px; y: (parent.height - 44px) / 2; width: 36px; height: 44px; border-radius: 6px;
                    background: na.has-hover ? #00000099 : #00000040; opacity: (ta.has-hover || na.has-hover) ? 1 : 0; animate opacity { duration: Theme.t-fast; }
                    Icon { glyph: @image-url("icons/chevron-right.svg"); size: 22px; tint: #ffffff; x: 7px; y: 11px; }
                    na := TouchArea { mouse-cursor: pointer; clicked => { App.act("next", 0); } } }
            }
            // zoom bar
            if !App.fullscreen : Rectangle {
                height: 44px; background: Theme.layer;
                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 4px; alignment: center;
                    IconBtn { y: 6px; glyph: @image-url("icons/zoom-out.svg"); tip: Tr.t("act.zoomOut"); clicked => { root.zoom-step(0.8); } }
                    Text { text: App.zoom-text; color: Theme.text-2; font-size: Theme.fs-small; width: 52px; horizontal-alignment: center; vertical-alignment: center; }
                    IconBtn { y: 6px; glyph: @image-url("icons/zoom-in.svg"); tip: Tr.t("act.zoomIn"); clicked => { root.zoom-step(1.25); } }
                    IconBtn { y: 6px; glyph: @image-url("icons/scan.svg"); tip: Tr.t("act.fit"); clicked => { root.fit-window(); } }
                    Btn { y: 6px; text: "1:1"; height: 32px; clicked => { root.actual-size(); } }
                    IconBtn { y: 6px; glyph: @image-url("icons/maximize.svg"); tip: Tr.t("act.fullscreen"); clicked => { App.act("fullscreen", 0); } }
                }
            }
            // filmstrip
            if !App.fullscreen && App.strip.length > 1 : Rectangle {
                height: 78px; background: Theme.layer;
                Flickable {
                    content-width: strip-row.preferred-width + 16px;
                    strip-row := HorizontalLayout {
                        padding: 8px; spacing: 6px; alignment: start;
                        for s in App.strip : Rectangle {
                            width: 62px; height: 62px; border-radius: 6px; clip: true; background: Theme.subtle-hover;
                            border-width: s.current ? 2px : 0px; border-color: Theme.accent;
                            init => { if (!s.loaded) { App.need-strip-thumb(s.idx); } }
                            if s.loaded : Image { source: s.thumb; width: parent.width; height: parent.height; image-fit: cover; opacity: s.current ? 1 : 0.8; }
                            TouchArea { mouse-cursor: pointer; clicked => { App.act("goto", s.idx); } }
                        }
                    }
                }
            }
        }
        // details panel
        if App.info-open && !App.fullscreen : Rectangle {
            width: 300px; background: Theme.layer; border-width: 0px;
            Rectangle { x: 0px; width: 1px; height: parent.height; background: Theme.stroke; }
            Flickable {
                content-height: info-col.preferred-height + 24px;
                info-col := VerticalLayout {
                    padding: 16px; spacing: 10px;
                    Text { text: Tr.t("info.title"); color: Theme.text; font-size: 16px * Theme.scale; font-weight: 600; }
                    Rectangle { height: 90px; border-radius: 6px; background: Theme.card; border-width: 1px; border-color: Theme.stroke;
                        Text { x: 8px; y: 4px; text: Tr.t("info.histogram"); color: Theme.text-3; font-size: Theme.fs-small; }
                        Path { x: 8px; y: 22px; width: parent.width - 16px; height: parent.height - 28px; viewbox-width: 256; viewbox-height: 100; commands: App.hist-luma; fill: Theme.text-3.with-alpha(0.35); stroke: Theme.text-3; stroke-width: 0.8px; }
                        Path { x: 8px; y: 22px; width: parent.width - 16px; height: parent.height - 28px; viewbox-width: 256; viewbox-height: 100; commands: App.hist-r; stroke: #e5484d; stroke-width: 0.8px; opacity: 0.8; }
                        Path { x: 8px; y: 22px; width: parent.width - 16px; height: parent.height - 28px; viewbox-width: 256; viewbox-height: 100; commands: App.hist-g; stroke: #30a46c; stroke-width: 0.8px; opacity: 0.8; }
                        Path { x: 8px; y: 22px; width: parent.width - 16px; height: parent.height - 28px; viewbox-width: 256; viewbox-height: 100; commands: App.hist-b; stroke: #3e63dd; stroke-width: 0.8px; opacity: 0.8; }
                    }
                    for r in App.info-rows : VerticalLayout { spacing: 1px;
                        Text { text: r.label; color: Theme.text-3; font-size: Theme.fs-small; }
                        Text { text: r.value; color: Theme.text; font-size: Theme.fs; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}
