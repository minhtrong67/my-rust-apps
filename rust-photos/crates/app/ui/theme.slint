import { Palette } from "std-widgets.slint";
export { Palette }
// Fluent colours. Rust sets `dark`, `solid` and the accent shades; everything else derives from them.
export global Theme {
    // 0 follow the system, 1 light, 2 dark. Palette.color-scheme is never written: Slint keeps it
    // in sync with Windows, and writing it would stop that for good.
    in property <int> mode: 0;
    out property <bool> dark: mode == 2 || (mode == 0 && Palette.color-scheme == ColorScheme.dark);
    // true when no Mica / Acrylic backdrop is active: draw solid surfaces
    in-out property <bool> solid: false;
    // [fill, hover, press, text, on-accent]
    in property <[color]> acc-light: [#ba3b25, #a13320, #882b1b, #882b1b, #ffffff];
    in property <[color]> acc-dark: [#c7452c, #d94f34, #e65a3e, #ff9a7e, #ffffff];
    out property <color> accent: dark ? acc-dark[0] : acc-light[0];
    out property <color> accent-hover: dark ? acc-dark[1] : acc-light[1];
    out property <color> accent-press: dark ? acc-dark[2] : acc-light[2];
    out property <color> accent-text: dark ? acc-dark[3] : acc-light[3];
    out property <color> on-accent: dark ? acc-dark[4] : acc-light[4];
    // 1.0 = 14px base text. Small 0.875, large 1.125.
    in-out property <float> scale: 1.0;
    in-out property <bool> reduce-motion: false;

    // WinUI 3 / Fluent tokens. Surfaces: Mica base, layer, card; controls have their own fills and strokes.
    out property <color> app-bg: solid ? (dark ? #202020 : #f3f3f3) : transparent;
    out property <color> layer: dark ? (solid ? #2b2b2b : #3a3a3a4d) : (solid ? #f9f9f9 : #ffffff80);
    out property <color> card: dark ? #ffffff0d : #ffffffb3;
    out property <color> card-hover: dark ? #ffffff15 : #f9f9f980;
    out property <color> surface: dark ? #272727 : #f9f9f9;
    out property <color> flyout: dark ? #2c2c2c : #fcfcfc;            // menus, tooltips, toasts
    out property <color> dialog: dark ? #2b2b2b : #f9f9f9;            // content dialog body
    out property <color> command-space: dark ? #202020 : #f3f3f3;     // content dialog button area
    out property <color> control: dark ? #ffffff0f : #ffffffb3;
    out property <color> control-hover: dark ? #ffffff15 : #f9f9f980;
    out property <color> control-press: dark ? #ffffff08 : #f9f9f94d;
    out property <color> control-solid: dark ? #454545 : #ffffff;
    out property <color> control-stroke: dark ? #ffffff12 : #0000000f;
    out property <color> text: dark ? #ffffff : #000000e4;
    out property <color> text-2: dark ? #ffffffc5 : #0000009e;
    out property <color> text-3: dark ? #ffffff87 : #00000072;
    out property <color> text-disabled: dark ? #ffffff5d : #0000005c;
    out property <color> stroke: dark ? #ffffff15 : #0000000f;
    out property <color> stroke-strong: dark ? #ffffff30 : #00000029;
    out property <color> subtle-hover: dark ? #ffffff0f : #00000009;
    out property <color> subtle-press: dark ? #ffffff0a : #00000006;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <color> scrim: #0000004d;
    out property <color> viewer-bg: dark ? #111111 : #eeeeee;
    out property <length> fs: 14px * scale;
    out property <length> fs-small: 12px * scale;
    out property <length> fs-title: 20px * scale;
    out property <length> fs-header: 28px * scale;
    out property <duration> t-fast: reduce-motion ? 0ms : 120ms;
    out property <duration> t-med: reduce-motion ? 0ms : 200ms;
}

// Translations live in Rust; `rev` changes when the language does, which re-evaluates every label.
export global Tr {
    in-out property <int> rev: 0;
    pure callback translate(string, int) -> string;
    pure public function t(key: string) -> string {
        return self.translate(key, self.rev);
    }
}
