import { Theme, Tr } from "theme.slint";
import { App } from "state.slint";
import { Icon, IconBtn, Btn, FSwitch, FSlider, Segmented, Dropdown, FTextBox, Stepper } from "widgets.slint";

component Modal inherits Rectangle {
    in property <length> w: 420px;
    in property <string> title;
    callback dismiss();
    background: Theme.scrim;
    TouchArea { clicked => { root.dismiss(); } }
    Rectangle {
        width: min(root.w, parent.width - 32px);
        height: min(col.preferred-height + 8px, parent.height - 32px);
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: Theme.dialog; border-radius: 8px; border-width: 1px; border-color: Theme.stroke-strong;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 8px;
        TouchArea { }
        col := VerticalLayout { padding: 20px; spacing: 14px;
            Text { text: root.title; color: Theme.text; font-size: 18px * Theme.scale; font-weight: 600; wrap: word-wrap; }
            @children
        }
    }
}

export component ConfirmDialog inherits Modal {
    title: App.confirm-title;
    dismiss => { App.confirm-result(false); }
    Text { text: App.confirm-desc; color: Theme.text-2; font-size: Theme.fs; wrap: word-wrap; }
    HorizontalLayout { spacing: 8px; alignment: end;
        Btn { text: Tr.t("cancel"); clicked => { App.confirm-result(false); } }
        Btn { text: App.confirm-yes; accent: !App.confirm-danger; danger: App.confirm-danger; clicked => { App.confirm-result(true); } }
    }
}

export component PromptDialog inherits Modal {
    title: App.prompt-title;
    dismiss => { App.prompt-result(false, ""); }
    Text { text: App.prompt-label; color: Theme.text-2; font-size: Theme.fs; }
    ed := FTextBox { text <=> App.prompt-value; accepted(t) => { App.prompt-result(true, t); } init => { self.focus-and-select(); } }
    HorizontalLayout { spacing: 8px; alignment: end;
        Btn { text: Tr.t("cancel"); clicked => { App.prompt-result(false, ""); } }
        Btn { text: App.prompt-yes; accent: true; clicked => { App.prompt-result(true, ed.text); } }
    }
}

export component BatchDialog inherits Modal {
    w: 520px;
    title: Tr.t("br.title");
    dismiss => { App.batch-open = false; }
    Text { text: Tr.t("br.pattern"); color: Theme.text-2; font-size: Theme.fs; }
    FTextBox { text <=> App.batch-pattern; edited(t) => { App.batch-changed(); } }
    Text { text: Tr.t("br.hint"); color: Theme.text-3; font-size: Theme.fs-small; wrap: word-wrap; }
    HorizontalLayout { spacing: 12px;
        VerticalLayout { spacing: 4px; Text { text: Tr.t("br.start"); color: Theme.text-2; font-size: Theme.fs-small; }
            Stepper { value <=> App.batch-start; minimum: 0; changed(v) => { App.batch-changed(); } } }
        VerticalLayout { spacing: 4px; Text { text: Tr.t("br.digits"); color: Theme.text-2; font-size: Theme.fs-small; }
            Stepper { value <=> App.batch-digits; minimum: 1; maximum: 8; changed(v) => { App.batch-changed(); } } }
    }
    Text { text: Tr.t("br.preview"); color: Theme.text-2; font-size: Theme.fs; }
    Rectangle { height: 110px; border-radius: 6px; background: Theme.card; border-width: 1px; border-color: Theme.stroke; clip: true;
        VerticalLayout { padding: 8px; spacing: 2px; for p in App.batch-preview : Text { text: p; color: Theme.text; font-size: Theme.fs-small; overflow: elide; } } }
    HorizontalLayout { spacing: 8px; alignment: end;
        Btn { text: Tr.t("cancel"); clicked => { App.batch-open = false; } }
        Btn { text: App.batch-apply-text; accent: true; clicked => { App.act("batch-apply", 0); } }
    }
}

export component DupDialog inherits Modal {
    w: 640px;
    title: Tr.t("dup.title");
    dismiss => { App.dup-open = false; }
    Text { text: App.dup-scanning ? Tr.t("dup.scan") : App.dup-summary; color: Theme.text-2; font-size: Theme.fs; wrap: word-wrap; }
    Rectangle { height: 320px; border-radius: 6px; background: Theme.card; border-width: 1px; border-color: Theme.stroke; clip: true;
        Flickable { content-height: dcol.preferred-height + 8px;
            dcol := VerticalLayout { padding: 10px; spacing: 10px;
                for g[gi] in App.dup-groups : VerticalLayout { spacing: 4px;
                    Text { text: g.title; color: Theme.text-2; font-size: Theme.fs-small; font-weight: 600; }
                    for it[ii] in g.items : Rectangle { height: 46px; border-radius: 4px; background: it.keep ? Theme.subtle-hover : transparent;
                        HorizontalLayout { spacing: 10px; padding: 3px;
                            Rectangle { width: 40px; height: 40px; border-radius: 4px; clip: true; background: Theme.subtle-hover; Image { source: it.thumb; width: 40px; height: 40px; image-fit: cover; } }
                            VerticalLayout { alignment: center;
                                Text { text: it.name; color: Theme.text; font-size: Theme.fs; overflow: elide; }
                                Text { text: it.size; color: Theme.text-3; font-size: Theme.fs-small; } }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { App.dup-toggle(gi, ii); } }
                    }
                }
            }
        }
    }
    HorizontalLayout { spacing: 8px; alignment: end;
        Btn { text: Tr.t("close"); clicked => { App.dup-open = false; } }
        Btn { text: App.dup-trash-text; danger: true; enabled: App.dup-groups.length > 0; clicked => { App.act("dup-trash", 0); } }
    }
}

export component AlbumPicker inherits Modal {
    title: Tr.t("pick.album");
    dismiss => { App.album-pick-open = false; }
    if App.albums.length == 0 : Text { text: Tr.t("pick.noAlbum"); color: Theme.text-2; font-size: Theme.fs; }
    for a in App.albums : Rectangle { height: 38px; border-radius: 4px; background: ta.has-hover ? Theme.subtle-hover : transparent;
        HorizontalLayout { padding-left: 10px; spacing: 8px;
            Icon { glyph: @image-url("icons/folder-heart.svg"); size: 16px; y: 11px; tint: Theme.accent-text; }
            Text { text: a.name; color: Theme.text; font-size: Theme.fs; vertical-alignment: center; }
            Text { text: a.count; color: Theme.text-3; font-size: Theme.fs-small; vertical-alignment: center; } }
        ta := TouchArea { mouse-cursor: pointer; clicked => { App.pick-album(a.id); } } }
    HorizontalLayout { spacing: 8px; alignment: end;
        Btn { text: Tr.t("alb.new"); glyph: @image-url("icons/plus.svg"); clicked => { App.act("album-new-pick", 0); } }
        Btn { text: Tr.t("cancel"); clicked => { App.album-pick-open = false; } }
    }
}

export component AboutDialog inherits Modal {
    title: Tr.t("app");
    dismiss => { App.about-open = false; }
    Image { source: @image-url("icon.svg"); width: 64px; height: 64px; }
    Text { text: Tr.t("about.desc"); color: Theme.text-2; font-size: Theme.fs; wrap: word-wrap; }
    Text { text: App.app-version; color: Theme.text; font-size: Theme.fs; }
    Text { text: "minhtrong67 · " + Tr.t("about.ai"); color: Theme.text-2; font-size: Theme.fs-small; wrap: word-wrap; }
    Text { text: "Made with Slint (royalty-free license) · Lucide icons (ISC)"; color: Theme.text-3; font-size: Theme.fs-small; wrap: word-wrap; }
    HorizontalLayout { alignment: end; Btn { text: Tr.t("close"); clicked => { App.about-open = false; } } }
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    Text { text: root.title; color: Theme.text; font-size: 15px * Theme.scale; font-weight: 600; }
    @children
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    height: max(52px, hl.preferred-height + 16px);
    border-radius: 4px; background: Theme.card; border-width: 1px; border-color: Theme.stroke;
    hl := HorizontalLayout { padding: 10px; padding-left: 14px; spacing: 12px;
        VerticalLayout { horizontal-stretch: 1; alignment: center;
            Text { text: root.title; color: Theme.text; font-size: Theme.fs; wrap: word-wrap; }
            if root.desc != "" : Text { text: root.desc; color: Theme.text-3; font-size: Theme.fs-small; wrap: word-wrap; } }
        VerticalLayout { alignment: center; @children }
    }
}

export component SettingsDialog inherits Rectangle {
    background: Theme.scrim;
    TouchArea { clicked => { App.settings-open = false; } }
    Rectangle {
        width: min(680px, parent.width - 32px); height: min(700px, parent.height - 32px);
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: Theme.dialog; border-radius: 8px; border-width: 1px; border-color: Theme.stroke-strong;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 8px;
        TouchArea { }
        VerticalLayout {
            Rectangle { height: 56px;
                HorizontalLayout { padding-left: 20px; padding-right: 10px;
                    Text { text: Tr.t("set.title"); color: Theme.text; font-size: 20px * Theme.scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    IconBtn { y: 12px; glyph: @image-url("icons/x.svg"); tip: Tr.t("close"); clicked => { App.settings-open = false; } } } }
            Flickable { vertical-stretch: 1; content-height: sc.preferred-height + 20px;
                sc := VerticalLayout { padding: 20px; padding-top: 4px; spacing: 18px;
                    Section { title: Tr.t("set.appearance");
                        SettingRow { title: Tr.t("set.theme");
                            Segmented { width: 270px; items: [Tr.t("set.theme.system"), Tr.t("set.theme.light"), Tr.t("set.theme.dark")]; index: App.set-theme; picked(i) => { App.set-theme = i; App.set("theme", i); } } }
                        SettingRow { title: Tr.t("set.color");
                            VerticalLayout { spacing: 6px; width: 300px;
                                Flickable { height: ceil(App.swatches.length / 8) * 32px + 4px; content-width: 300px;
                                    for i in App.swatches.length : Rectangle { x: mod(i, 8) * 36px; y: floor(i / 8) * 32px; width: 30px; height: 28px; border-radius: 14px;
                                        background: App.swatches[i]; border-width: App.set-accent-index == i ? 2px : 0px; border-color: Theme.text;
                                        TouchArea { mouse-cursor: pointer; clicked => { App.set-accent-index = i; App.set("accent", i); } } } }
                            } }
                        SettingRow { title: Tr.t("set.material"); desc: App.material-ok ? Tr.t("set.material.d") : Tr.t("set.material.unsupported");
                            Dropdown { width: 150px; items: ["None", "Mica", "Mica Alt", "Acrylic"]; index: App.set-material; picked(i) => { App.set-material = i; App.set("material", i); } } }
                        SettingRow { title: Tr.t("set.fontSize");
                            Segmented { width: 240px; items: [Tr.t("set.size.sm"), Tr.t("set.size.md"), Tr.t("set.size.lg")]; index: App.set-font-size; picked(i) => { App.set-font-size = i; App.set("font-size", i); } } }
                        SettingRow { title: Tr.t("set.language");
                            Segmented { width: 200px; items: ["Tiếng Việt", "English"]; index: App.set-lang; picked(i) => { App.set-lang = i; App.set("lang", i); } } }
                        SettingRow { title: Tr.t("set.animations"); desc: Tr.t("set.animations.d");
                            FSwitch { checked: App.set-reduce-motion; toggled(c) => { App.set-reduce-motion = c; App.set("reduce-motion", c ? "1" : "0"); } } }
                    }
                    Section { title: Tr.t("set.window");
                        SettingRow { title: Tr.t("set.window.startup");
                            Segmented { width: 330px; items: [Tr.t("set.window.remember"), Tr.t("set.window.max")]; index: App.set-window-mode; picked(i) => { App.set-window-mode = i; App.set("window-mode", i); } } }
                    }
                    Section { title: Tr.t("set.library");
                        SettingRow { title: Tr.t("set.libPath"); desc: App.set-library-path == "" ? Tr.t("set.libPath.default") : App.set-library-path;
                            HorizontalLayout { spacing: 6px;
                                Btn { text: Tr.t("set.libPath.choose"); clicked => { App.act("lib-choose", 0); } }
                                Btn { text: Tr.t("set.libPath.reset"); enabled: App.set-library-path != ""; clicked => { App.act("lib-reset", 0); } } } }
                        SettingRow { title: Tr.t("set.autoLoad"); desc: Tr.t("set.autoLoad.d");
                            FSwitch { checked: App.set-auto-load; toggled(c) => { App.set-auto-load = c; App.set("auto-load", c ? "1" : "0"); } } }
                    }
                    Section { title: Tr.t("set.viewer");
                        SettingRow { title: Tr.t("set.confirmDelete");
                            FSwitch { checked: App.set-confirm-delete; toggled(c) => { App.set-confirm-delete = c; App.set("confirm-delete", c ? "1" : "0"); } } }
                        SettingRow { title: Tr.t("set.keepExif");
                            FSwitch { checked: App.set-keep-exif; toggled(c) => { App.set-keep-exif = c; App.set("keep-exif", c ? "1" : "0"); } } }
                        SettingRow { title: Tr.t("set.saveQuality") + ": " + App.set-quality;
                            FSlider { width: 200px; minimum: 50; maximum: 100; value: App.set-quality; changed(v) => { App.set-quality = round(v); } released(v) => { App.set("quality", round(v)); } } }
                        SettingRow { title: Tr.t("view.interval") + ": " + App.set-slide-interval + " s";
                            FSlider { width: 200px; minimum: 1; maximum: 15; value: App.set-slide-interval; changed(v) => { App.set-slide-interval = round(v); } released(v) => { App.set("slide-interval", round(v)); } } }
                        SettingRow { title: Tr.t("view.transition");
                            Segmented { width: 260px; items: [Tr.t("tr.fade"), Tr.t("tr.slide"), Tr.t("tr.zoom")]; index: App.set-slide-transition; picked(i) => { App.set-slide-transition = i; App.set("slide-transition", i); } } }
                        SettingRow { title: Tr.t("view.shuffle");
                            FSwitch { checked: App.set-slide-shuffle; toggled(c) => { App.set-slide-shuffle = c; App.set("slide-shuffle", c ? "1" : "0"); } } }
                        SettingRow { title: Tr.t("view.loop");
                            FSwitch { checked: App.set-slide-loop; toggled(c) => { App.set-slide-loop = c; App.set("slide-loop", c ? "1" : "0"); } } }
                    }
                    Section { title: Tr.t("set.about");
                        HorizontalLayout { spacing: 8px; alignment: start;
                            Btn { text: Tr.t("set.about"); clicked => { App.about-open = true; } }
                            Btn { text: Tr.t("set.resetAll"); danger: true; clicked => { App.act("settings-reset", 0); } } } }
                }
            }
        }
    }
}
